1. inventory — файл инвентаризации

[servers]
your_server_ip

[servers:vars]
ansible_user=your_user
ansible_ssh_private_key_file=/path/to/your/private/key


2. playbook.yml — основной playbook

---
- name: Настройка сервера Ubuntu 20.04
  hosts: servers
  become: true
  tasks:
    - name: Подготовка сервера
      include_tasks: roles/nginx/tasks/main.yml

    - name: Установка PHP-FPM
      include_tasks: roles/php_fpm/tasks/main.yml

    - name: Установка и настройка MySQL
      include_tasks: roles/mysql/tasks/main.yml

    - name: Настройка SSH
      include_tasks: roles/ssh/tasks/main.yml

    - name: Настройка CSF
      include_tasks: roles/csf/tasks/main.yml

    - name: Установка и настройка WordPress
      include_tasks: roles/wordpress/tasks/main.yml

    - name: Настройка бекапов
      include_tasks: roles/backup/tasks/main.yml

    - name: Настройка мониторинга
      include_tasks: roles/monitoring/tasks/main.yml


3. roles/nginx/tasks/main.yml — роль для Nginx   

---
- name: Установка Nginx
  apt:
    name: nginx
    state: latest
    update_cache: yes

- name: Настройка виртуального хоста
  template:
    src: nginx_site.conf.j2
    dest: "/etc/nginx/sites-available/{{ nginx_site_name }}"
    owner: root
    group: root
    mode: '0644'

- name: Активировать виртуальный хост
  command: nginx -t && ln -s /etc/nginx/sites-available/{{ nginx_site_name }} /etc/nginx/sites-enabled/

- name: Перезапуск Nginx
  service:
    name: nginx
    state: restarted

