Шаблон для конфигурации сайта nginx_site.conf.j2:

server {
    listen 80;
    server_name {{ domain_name }};
    root /var/www/{{ domain_name }};
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/{{ domain_name }}/$document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }
}


4. roles/php_fpm/tasks/main.yml — роль для PHP-FPM

---
- name: Установка PHP 8.1 и необходимых пакетов
  apt:
    name:
      - php8.1-fpm
      - php8.1-mysql
      - php8.1-cli
      - php8.1-xml
      - php8.1-mbstring
      - php8.1-curl
      - php8.1-zip
    state: latest
    update_cache: yes

- name: Перезапуск PHP-FPM
  service:
    name: php8.1-fpm
    state: restarted


5. roles/mysql/tasks/main.yml — роль для MySQL

---
- name: Установка MySQL
  apt:
    name: mysql-server
    state: latest
    update_cache: yes

- name: Создание базы данных для WordPress
  mysql_db:
    name: "{{ mysql_db_name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Создание пользователя MySQL
  mysql_user:
    name: "{{ mysql_user_name }}"
    password: "{{ mysql_user_password }}"
    priv: "{{ mysql_db_name }}.*:ALL"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"


6. roles/ssh/tasks/main.yml — роль для SSH

---
- name: Настройка SSH
  block:
    - name: Запретить авторизацию по паролю
      lineinfile:
        path: /etc/ssh/sshd_config
        regexp: '^PasswordAuthentication'
        line: 'PasswordAuthentication no'

    - name: Разрешить авторизацию по ключам
      lineinfile:
        path: /etc/ssh/sshd_config
        regexp: '^PubkeyAuthentication'
        line: 'PubkeyAuthentication yes'

    - name: Настроить список разрешённых IP
      lineinfile:
        path: /etc/hosts.allow
        line: "sshd: {{ item }}"
      with_items: "{{ allowed_ips }}"

    - name: Изменить SSH порт на 1234
      lineinfile:
        path: /etc/ssh/sshd_config
        regexp: '^#Port 22'
        line: 'Port 1234'

    - name: Перезапустить SSH
      service:
        name: ssh
        state: restarted


7. roles/csf/tasks/main.yml — роль для CSF

---
- name: Установка CSF
  apt:
    name: csf
    state: present
    update_cache: yes

- name: Перезапуск CSF
  service:
    name: csf
    state: restarted

8. roles/wordpress/tasks/main.yml — роль для WordPress

---
- name: Установка WordPress
  get_url:
    url: https://wordpress.org/latest.tar.gz
    dest: /tmp/wordpress.tar.gz

- name: Распаковка WordPress
  unarchive:
    src: /tmp/wordpress.tar.gz
    dest: /var/www/{{ domain_name }}
    copy: no

- name: Настройка прав на файлы WordPress
  file:
    path: /var/www/{{ domain_name }}
    owner: www-data
    group: www-data
    recurse: yes


9. roles/backup/tasks/main.yml — роль для бекапов

---
- name: Настройка бекапов
  cron:
    name: "Backup every day at 2AM"
    minute: "0"
    hour: "2"
    job: "/usr/bin/tar -czf /var/backups/wordpress_$(date +\%F).tar.gz /var/www/{{ domain_name }}"



10. roles/monitoring/tasks/main.yml — роль для мониторинга

---
- name: Установка мониторинга (например, Prometheus)
  apt:
    name: prometheus
    state: latest
    update_cache: yes

- name: Настройка мониторинга
  service:
    name: prometheus
    state: started
    enabled: true


